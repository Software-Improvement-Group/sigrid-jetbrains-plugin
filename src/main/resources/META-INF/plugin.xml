<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.softwareimprovementgroup.plugins.sigrid</id>
    <name>Sigrid</name>
    <vendor>softwareimprovementgroup</vendor>
    <description><![CDATA[
        <p><b>Sigrid</b> brings software quality analysis directly into your JetBrains IDE, allowing developers to review findings without switching to the Sigrid web application.</p>
        <p>The extension helps you identify and address software quality issues earlier in your development workflow by providing access to Sigrid findings directly within your IDE.</p>

        <h2>Features</h2>
        <ul>
            <li>View Maintainability findings</li>
            <li>View Security findings</li>
            <li>View Open Source Health findings</li>
            <li>Navigate directly to affected source code</li>
            <li>Search and filter findings</li>
            <li>Update finding status and remarks</li>
            <li>Open findings in Sigrid for additional context</li>
            <li>Supports multiple JetBrains IDEs (IntelliJ IDEA, PyCharm, WebStorm, GoLand, Rider, and others)</li>
        </ul>

        <h2>Requirements</h2>
        <p>To use this plugin you need:</p>
        <ul>
            <li>A Sigrid account</li>
            <li>A Sigrid API token</li>
            <li>Customer ID</li>
            <li>System ID</li>
        </ul>
        <p>Configuration instructions are available in the <a href="https://docs.sigrid-says.com/integrations/jetbrains-extension.html">Sigrid documentation</a>.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="withTerminal.xml">org.jetbrains.plugins.terminal</depends>

    <resource-bundle>messages.Sigrid</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity
                implementation="com.softwareimprovementgroup.plugins.sigrid.services.UsageStatisticsActivity"/>
        <postStartupActivity
                implementation="com.softwareimprovementgroup.plugins.sigrid.services.ClaudeCodeWarmupActivity"/>
        <applicationConfigurable
                instance="com.softwareimprovementgroup.plugins.sigrid.settings.SigridSettingsConfigurable"
                id="com.softwareimprovementgroup.plugins.sigrid.settings"
                parentId="tools"
                key="settings.display.name"/>
        <projectConfigurable
                instance="com.softwareimprovementgroup.plugins.sigrid.settings.SigridProjectSettingsConfigurable"
                id="com.softwareimprovementgroup.plugins.sigrid.settings.project"
                parentId="com.softwareimprovementgroup.plugins.sigrid.settings"
                key="settings.project.display.name"
                order="first"/>
        <applicationConfigurable
                instance="com.softwareimprovementgroup.plugins.sigrid.settings.SigridIssueTrackersConfigurable"
                id="com.softwareimprovementgroup.plugins.sigrid.settings.integrations"
                parentId="com.softwareimprovementgroup.plugins.sigrid.settings"
                key="settings.integrations.display.name"/>
        <projectConfigurable
                instance="com.softwareimprovementgroup.plugins.sigrid.settings.SigridJiraSettingsConfigurable"
                id="com.softwareimprovementgroup.plugins.sigrid.settings.jira"
                parentId="com.softwareimprovementgroup.plugins.sigrid.settings.integrations"
                key="settings.jira.display.name"/>
        <applicationConfigurable
                instance="com.softwareimprovementgroup.plugins.sigrid.settings.SigridAzureDevOpsSettingsConfigurable"
                id="com.softwareimprovementgroup.plugins.sigrid.settings.azuredevops"
                parentId="com.softwareimprovementgroup.plugins.sigrid.settings.integrations"
                key="settings.azure.devops.display.name"/>
        <projectConfigurable
                instance="com.softwareimprovementgroup.plugins.sigrid.settings.SigridAzureDevOpsProjectSettingsConfigurable"
                id="com.softwareimprovementgroup.plugins.sigrid.settings.azuredevops.project"
                parentId="com.softwareimprovementgroup.plugins.sigrid.settings.azuredevops"
                key="settings.azure.devops.project.display.name"/>

        <toolWindow
                factoryClass="com.softwareimprovementgroup.plugins.sigrid.toolWindow.SigridWindowFactory"
                id="Sigrid"
                anchor="bottom"
                icon="/icons/sigrid.png"
        />
        <notificationGroup id="Sigrid" displayType="BALLOON" key="settings.display.name"/>
    </extensions>
</idea-plugin>